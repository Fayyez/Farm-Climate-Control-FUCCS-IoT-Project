# Particle Cloud API — create token at https://console.particle.io/
PARTICLE_ACCESS_TOKEN=
PARTICLE_DEVICE_ID=

# Seconds between polls (minimum enforced in code: 5)
POLL_INTERVAL_SECONDS=30

# If auto-discovery fails (all aliases 404), set exact Particle.variable() names:
# PARTICLE_VAR_TEMPERATURE=
# PARTICLE_VAR_HUMIDITY=
# PARTICLE_VAR_SMOKE=
# PARTICLE_VAR_WINDOW_STATUS=
# PARTICLE_VAR_COOLING_STATUS=

# Logging: DEBUG (verbose), INFO (default), WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: override CSV path (default: model/sensor_history.csv)
# SENSOR_CSV_PATH=model/sensor_history.csv

# Optional: Particle API base URL (default https://api.particle.io/v1)
# PARTICLE_API_BASE=https://api.particle.io/v1
